venv/
__pycache__/
*.pyc
credentials.json
# Local high scores — per machine, never shared
leaderboard.json

# OS and editor litter. Thumbs.db is the one that actually turns up here:
# Explorer writes it into any folder whose images have been previewed, and
# assets/ is a folder of PNGs someone opens to check the artwork.
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Icons are derived from assets/logo_white.png by packaging/make_icon.py, which
# the build runs. The source artwork is committed; the generated icons are not.
packaging/app_icon.ico
packaging/app_icon.icns
packaging/app_icon.iconset/

# PyInstaller output
build/
dist/
*.dmg
*.zip
# Installers built from dist/ — 80 MB+ each, and rebuilt from source anyway
*-setup.exe

# Diagnostic log written next to the source when running from a checkout
emotiv-drone.log
emotiv-drone.previous.log
# Diagnostic capture written beside the log on a source run.
motion-capture.csv
motion-capture.previous.csv
